{
  "manifest_version": 3,
  "name": "Tandem",
  "version": "0.1.0",
  "description": "Watch YouTube together with someone far away: both of you on youtube.com, in step.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Tandem",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "permissions": ["storage", "contextMenus"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["tandem.js", "youtube-page.js", "defaults.js", "sync-core.js", "sync-config.js", "socket.io.esm.min.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "tandem@tandem-watch-together",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["websiteActivity"] }
    }
  }
}
